{
  "name": "sistecpos-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Runtime genérico de escritorio (Electron) + print-agent. No contiene datos de ningún tenant.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron main.cjs",
    "agent": "node print-agent.cjs",

    "package:linux": "electron-packager .. SistecPOSDesktop --platform=linux --arch=x64 --electron-version=31.7.7 --out=../electron-release --overwrite --ignore=^/src --ignore=^/public --ignore=^/electron-release --ignore=^/supabase --ignore=^/docs --ignore=^/e2e --ignore=^/scripts --ignore=^/astro-starter --ignore=^/tests --ignore=^/.lovable --ignore=\\.env",
    "package:win": "electron-packager .. SistecPOSDesktop --platform=win32 --arch=x64 --electron-version=31.7.7 --out=../electron-release --overwrite --ignore=^/src --ignore=^/public --ignore=^/electron-release --ignore=^/supabase --ignore=^/docs --ignore=^/e2e --ignore=^/scripts --ignore=^/astro-starter --ignore=^/tests --ignore=^/.lovable --ignore=\\.env",
    "package:mac": "electron-packager .. SistecPOSDesktop --platform=darwin --arch=x64 --electron-version=31.7.7 --out=../electron-release --overwrite --ignore=^/src --ignore=^/public --ignore=^/electron-release --ignore=^/supabase --ignore=^/docs --ignore=^/e2e --ignore=^/scripts --ignore=^/astro-starter --ignore=^/tests --ignore=^/.lovable --ignore=\\.env"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "@electron/packager": "18.3.6"
  },
  "optionalDependencies": {
    "usb": "2.13.0",
    "@abandonware/noble": "1.9.2-25"
  }
}
