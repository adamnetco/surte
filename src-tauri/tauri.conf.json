{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SistecPOS Core",
  "version": "0.1.0",
  "identifier": "com.sistecpos.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SistecPOS Core",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© SistecPOS",
    "shortDescription": "POS multi-tenant offline-first",
    "longDescription": "Runtime de escritorio genérico de SistecPOS Core. El tenant se resuelve por licencia en tiempo de ejecución."
  }
}
